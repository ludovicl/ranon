{
  "name": "ranon-site",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./site"
  },
  "routes": [
    { "pattern": "ranon.app", "custom_domain": true },
    { "pattern": "www.ranon.app", "custom_domain": true },
    // old address, redirected to ranon.app by a rule on the lrds.app zone
    { "pattern": "ranon.lrds.app", "custom_domain": true }
  ]
}
